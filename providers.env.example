# providers.env — external LLM provider secrets for watsonx Orchestrate.
#
# Copy this file to providers.env (default ~/.config/cpd-onprem/providers.env,
# or point $WXO_PROVIDERS_ENV at it) and fill in the keys you use, then:
#   chmod 600 providers.env
# It is git-ignored and must stay that way — it holds plaintext API keys.
#
# Format:   NAME=VALUE   ('#' comments and blank lines are ignored; the value is
#           the rest of the line, stripped — no quotes needed)
# Naming:   WXO_<PROVIDER_UPPER>_<FIELD_UPPER>   (hyphens in a provider id become
#           underscores, e.g. mistral-ai -> WXO_MISTRAL_AI_API_KEY)
# Resolution: a real environment variable of the same name overrides the file.
#
# Only SECRET fields belong here. Non-secret config (custom_host, aws_region,
# vertex_project_id, vertex_region, …) goes on the model via
# `--provider-config KEY=VALUE`, never in this file.
#
# wxo_add_provider.py reads these and hands them to `orchestrate connections
# set-credentials` once; nothing else ever reads or prints the value.

# --- single api_key providers ---
# WXO_ANTHROPIC_API_KEY=sk-ant-...
# WXO_OPENAI_API_KEY=sk-...
# WXO_GOOGLE_API_KEY=...
# WXO_MISTRAL_AI_API_KEY=...
# WXO_GROQ_API_KEY=...
# WXO_COHERE_API_KEY=...
# WXO_TOGETHER_AI_API_KEY=...
# WXO_OPENROUTER_API_KEY=...
# WXO_X_AI_API_KEY=...
# WXO_JINA_API_KEY=...

# --- azure-openai (api_key secret; resource/deployment/api_version or custom_host
#     go in --provider-config) ---
# WXO_AZURE_OPENAI_API_KEY=...

# --- bedrock (two secret fields; aws_region goes in --provider-config) ---
# WXO_BEDROCK_AWS_ACCESS_KEY_ID=...
# WXO_BEDROCK_AWS_SECRET_ACCESS_KEY=...

# --- vertex-ai (service-account JSON as a single-line string; vertex_project_id
#     and vertex_region go in --provider-config) ---
# WXO_VERTEX_AI_VERTEX_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- ollama needs no secret; point it at your host with
#     --provider-config custom_host=http://your-ollama:11434/v1 ---
